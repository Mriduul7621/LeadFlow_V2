{
  "compilerOptions": {
    "target": "ES2022",

    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "jsx": "react-jsx",

    "allowJs": true,
    "allowImportingTsExtensions": true,

    "isolatedModules": true,
    "skipLibCheck": true,

    "noEmit": true,

    "typeRoots": [
      "./node_modules/@types",
      "./server/types"
    ]
  },

  "exclude": [
    "functions",
    "node_modules",
    "dist",
    "build",
    "src/generated"
  ]
}