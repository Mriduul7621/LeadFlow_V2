# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Supabase Connection URL (PostgreSQL Connection String)
# Example: postgresql://postgres:[password]@db.[id].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=""

# Supabase Client Credentials
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SESSION_SECRET: Used to sign login session tokens (server/auth.ts).
# REQUIRED for production - if unset, a random secret is generated at
# server boot, which means every server restart invalidates all
# existing login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""