# Server
PORT=3000
NODE_ENV=development

# PostgreSQL / Supabase
# Copy the connection string from Supabase Dashboard > Connect > Transaction pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true

# Authentication
# JWT_SECRET is REQUIRED in production and must be a strong, production-specific
# random value. Known weak/default values (including the development fallback)
# are rejected at startup and refuse to sign tokens. Generate with e.g.
#   openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret

# Build identification (optional). Exposed in the readiness endpoint and in
# structured request/error logs so operators can answer "what exact code is
# running?".
# Vercel sets VERCEL_GIT_COMMIT_SHA automatically; standalone operators may
# set GIT_SHA (or COMMIT_SHA).
# GIT_SHA=

# Observability (optional) — structured JSON request logs to stdout/stderr.
# See docs/PRODUCTION_OBSERVABILITY.md. No external service is involved.
# OBSERVABILITY_LOG_LEVEL=info        # debug | info | warn | error (default: info in production, debug elsewhere)
# OBSERVABILITY_SLOW_REQUEST_MS=2000  # warn when an /api request takes at least this long
# OBSERVABILITY_SLOW_DB_MS=750        # warn when a single PostgreSQL operation takes at least this long

# Reverse proxy / client identity (used by API + auth rate limiting)
# Leave unset when the standalone server is directly exposed to the internet.
# Behind ONE trusted proxy (nginx, ALB, Cloudflare, Docker ingress) set the
# number of trusted hops so rate limiting keys on the real client IP instead of
# lumping every user into the proxy's single bucket:
#   TRUST_PROXY=1
# Vercel sets this automatically (Vercel overwrites X-Forwarded-For with the
# real client IP). Avoid TRUST_PROXY=true: it trusts client-supplied
# X-Forwarded-For values and lets callers pick their own rate-limit bucket.
# TRUST_PROXY=1

# Supabase browser client
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
